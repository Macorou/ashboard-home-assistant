{
  "id": "macorou.home-assistant",
  "name": "Home Assistant",
  "description": "Affiche ton installation solaire depuis Home Assistant : flux de courant animés et bilan du jour. Module non affilié au projet Home Assistant.",
  "author": "Macorou",
  "version": "1.3.0",
  "sdk": "1.0",
  "entry": "HomeAssistant.dll",
  "permissions": [ "reseau-local", "internet" ],
  "repository": "Macorou/ashboard-home-assistant",
  "icon": "icon.png",
  "minSize": { "columns": 2, "rows": 1 },
  "presets": {
    "compact": { "columns": 5, "rows": 3 },
    "ideal": { "columns": 6, "rows": 4 },
    "large": { "columns": 8, "rows": 4 }
  },
  "settings": [
    { "kind": "text", "key": "ha_address", "label": "Adresse de Home Assistant", "placeholder": "192.168.1.10:8123", "maxLength": 200, "help": "Par exemple 192.168.1.10:8123, ou https://maison.exemple.fr:8123 si ton Home Assistant est en HTTPS. Laissé vide, le champ reprend la dernière adresse utilisée." },
    { "kind": "secret", "key": "ha_token", "label": "Clé API (jeton longue durée)", "help": "Crée-la dans Home Assistant : ouvre ton profil, onglet Sécurité, puis « Jetons d'accès longue durée ». Partagée par toutes les cases du module." },
    { "kind": "action", "key": "test", "label": "Tester la connexion" },
    { "kind": "action", "key": "forget_cert", "label": "Oublier le certificat", "confirm": "Oublier le certificat de Home Assistant mémorisé ? Il sera appris de nouveau à la prochaine connexion." },
    {
      "kind": "choice", "key": "display", "label": "Affichage",
      "options": [
        { "value": "energy", "label": "Flux d'énergie" },
        { "value": "daily", "label": "Bilan du jour" }
      ],
      "default": "energy"
    },
    {
      "kind": "choice", "key": "day_shape", "label": "Forme",
      "options": [
        { "value": "strip", "label": "Bande, une ligne" },
        { "value": "list", "label": "Liste, en hauteur" }
      ],
      "default": "strip",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "list", "key": "day_values", "label": "Valeurs à afficher et ordre",
      "options": [
        { "value": "consumption", "label": "Consommation" },
        { "value": "production", "label": "Production" },
        { "value": "import", "label": "Import" },
        { "value": "export", "label": "Export" },
        { "value": "cost", "label": "Coût" },
        { "value": "resale", "label": "Gain de revente" },
        { "value": "car", "label": "Voiture" },
        { "value": "water", "label": "Eau" }
      ],
      "default": [ "consumption", "production", "import", "export", "cost", "resale", "car", "water" ],
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "lookup", "key": "day_consumption", "label": "Capteur de consommation du jour", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "lookup", "key": "day_production", "label": "Capteur de production du jour", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "lookup", "key": "day_import", "label": "Capteur d'import du jour", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "lookup", "key": "day_export", "label": "Capteur d'export du jour", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "lookup", "key": "day_car", "label": "Capteur de recharge de la voiture du jour", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "help": "L'énergie donnée à la voiture depuis minuit, en kWh.",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "lookup", "key": "day_water", "label": "Capteur d'eau du jour", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "help": "L'eau consommée depuis minuit, en litres ou en m³. Elle s'affiche en litres.",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "lookup", "key": "day_cost", "label": "Capteur de coût du jour", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "choice", "key": "day_price_mode", "label": "Prix de revente",
      "options": [
        { "value": "none", "label": "Aucun" },
        { "value": "typed", "label": "Saisi" },
        { "value": "sensor", "label": "Capteur Home Assistant" }
      ],
      "default": "none",
      "visibleWhen": { "key": "display", "value": "daily" }
    },
    {
      "kind": "text", "key": "day_price", "label": "Prix de revente, en €/kWh", "placeholder": "0,13", "maxLength": 12,
      "visibleWhen": { "key": "day_price_mode", "value": "typed" }
    },
    {
      "kind": "lookup", "key": "day_price_sensor", "label": "Capteur du prix de revente", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "day_price_mode", "value": "sensor" }
    },
    {
      "kind": "choice", "key": "layout", "label": "Disposition",
      "options": [
        { "value": "top", "label": "Pointe en haut" },
        { "value": "left", "label": "Maison à gauche" },
        { "value": "bottom", "label": "Maison en bas" }
      ],
      "default": "top",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "choice", "key": "house", "label": "Style de maison",
      "options": [
        { "value": "modern", "label": "Contemporaine" },
        { "value": "classic", "label": "Traditionnelle" }
      ],
      "default": "modern",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "lookup", "key": "solar", "label": "Capteur de production", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "help": "Le capteur de puissance de tes panneaux, en W ou en kW.",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "choice", "key": "grid_mode", "label": "Capteurs du réseau",
      "options": [
        { "value": "one", "label": "Un seul capteur" },
        { "value": "two", "label": "Deux capteurs, achat et vente" }
      ],
      "default": "one",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "lookup", "key": "grid", "label": "Capteur réseau", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "help": "Avec deux capteurs, c'est celui de l'achat.",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "toggle", "key": "grid_inverted", "label": "Positif à la vente", "default": false,
      "help": "Laisse décoché si ton capteur est positif quand tu achètes du courant. Ne sert qu'avec un seul capteur.",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "lookup", "key": "grid_export", "label": "Capteur de vente", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "grid_mode", "value": "two" }
    },
    {
      "kind": "lookup", "key": "home", "label": "Capteur de consommation (facultatif)", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun : consommation calculée",
      "help": "Laisse vide pour que la consommation soit calculée à partir des autres capteurs.",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "choice", "key": "battery_mode", "label": "Batterie",
      "options": [
        { "value": "none", "label": "Pas de batterie" },
        { "value": "one", "label": "Un seul capteur de puissance" },
        { "value": "two", "label": "Deux capteurs, charge et décharge" }
      ],
      "default": "none",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "lookup", "key": "battery", "label": "Capteur de puissance de la batterie", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "battery_mode", "value": "one" }
    },
    {
      "kind": "toggle", "key": "battery_inverted", "label": "Positif en charge", "default": false,
      "help": "Laisse décoché si ton capteur est positif quand la batterie se décharge.",
      "visibleWhen": { "key": "battery_mode", "value": "one" }
    },
    {
      "kind": "lookup", "key": "battery_charge", "label": "Capteur de charge", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "battery_mode", "value": "two" }
    },
    {
      "kind": "lookup", "key": "battery_discharge", "label": "Capteur de décharge", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "visibleWhen": { "key": "battery_mode", "value": "two" }
    },
    {
      "kind": "lookup", "key": "battery_soc", "label": "Niveau de la batterie, en % (facultatif)", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun : pas de pourcentage",
      "help": "Sans lui, la jauge reste éteinte et le pourcentage n'est pas affiché.",
      "visibleWhen": { "key": "battery_mode", "value": "one" }
    },
    {
      "kind": "lookup", "key": "battery_soc2", "label": "Niveau de la batterie, en % (facultatif)", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun : pas de pourcentage",
      "help": "Sans lui, la jauge reste éteinte et le pourcentage n'est pas affiché.",
      "visibleWhen": { "key": "battery_mode", "value": "two" }
    },
    {
      "kind": "choice", "key": "car_mode", "label": "Voiture électrique",
      "options": [
        { "value": "none", "label": "Pas de voiture" },
        { "value": "one", "label": "Une voiture" }
      ],
      "default": "none",
      "visibleWhen": { "key": "display", "value": "energy" }
    },
    {
      "kind": "lookup", "key": "car_power", "label": "Capteur de puissance de recharge", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun capteur choisi",
      "help": "La puissance que tire la voiture, en W ou en kW.",
      "visibleWhen": { "key": "car_mode", "value": "one" }
    },
    {
      "kind": "lookup", "key": "car_plug", "label": "Capteur « voiture branchée » (facultatif)", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun : branchée inconnue",
      "help": "Un capteur on/off qui dit si la voiture est branchée.",
      "visibleWhen": { "key": "car_mode", "value": "one" }
    },
    {
      "kind": "lookup", "key": "car_soc", "label": "Niveau de la voiture, en % (facultatif)", "labelPath": "name",
      "placeholder": "Tape un nom de capteur", "emptyLabel": "Aucun : pas de pourcentage",
      "help": "Sans lui, le pourcentage de la voiture n'est pas affiché.",
      "visibleWhen": { "key": "car_mode", "value": "one" }
    },
    {
      "kind": "choice", "key": "car_color", "label": "Couleur de la voiture",
      "options": [
        { "value": "blue", "label": "Bleu vif" },
        { "value": "yellow", "label": "Jaune" },
        { "value": "white", "label": "Blanc nacré" }
      ],
      "default": "blue",
      "visibleWhen": { "key": "car_mode", "value": "one" }
    }
  ]
}
